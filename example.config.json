  "showStoptimesForRequestStops": true,
  "skipImport": false,
  "sortingAlgorithm": "common",
  "templatePath": "views/custom/",
  "timeFormat": "h:mma",
  "useParentStation": true,
  "verbose": true,
  "zipOutput": false
}
