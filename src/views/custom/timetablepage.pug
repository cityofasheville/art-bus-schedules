include formatting_functions.pug

div(class="w-full max-w-screen-lg mx-auto px-6 py-8")
  <!-- Timetable generated on #{new Date().toISOString()} using GTFS-to-HTML version #{config.gtfsToHtmlVersion} -->
  div(class=`timetable-page menu-type-${config.menuType}`)
    if config.showRouteTitle
      - const timetableRouteList = _.uniqBy(_.flatMap(timetablePage.consolidatedTimetables, timetable => timetable.routes), 'route_id')
      div(class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-4")
        div(class="timetable-heading flex py-4 gap-4")
          each route in timetableRouteList
            .route-color-swatch-large(style=`background-color: ${formatRouteColor(route)}; color: ${formatRouteTextColor(route)};`)= route.route_short_name || ''
          div()
            div(class="flex flex-wrap items-center gap-2 mb-2 pt-2")
              h1(class="mt-0 mb-2 py-0")= timetablePage.timetable_page_label
              div(class="timetable-link")
                each route in timetableRouteList
                  if route.route_url
                    a(href=`${route.route_url}` class="text-link text-sm")=`Printable Map & Schedule (PDF)`
            if timetablePage.timetables[0].routes[0].route_desc
              p(class="my-0 py-0 text-sm")= timetablePage.timetables[0].routes[0].route_desc
      if config.effectiveDate
        .effective-date= `Effective ${config.effectiveDate}`

    div(id="route_alerts_container" class="mb-12")
      if config.hasGtfsRealtimeAlerts
        details(class="border my-6 rounded text-aux-black overflow-hidden" aria-labelledby="service_alerts_heading")
          summary(class="list-none flex gap-4 align-middle justify-between py-2 px-5 cursor-pointer")
            
            div(class="flex items-start gap-2 text-base xs:text-lg md:text-xl ")

              div(class="pt-0.5")
                i(class="bi bi-bell-fill" aria-hidden="true")

              div(class="flex flex-wrap gap-2 ")
                h2(id="service_alerts_heading" class="mb-0 pt-0.5")= timetablePage.timetable_page_label + ": Service Alerts"
                span(id="timetable_alert_count" class="rounded-lg border-2 px-2 text-sm xs:text-base md:text-lg")="Checking alerts..."
            
            div(class="flex items-center justify-center")
              span(class="bi bi-chevron-down justify-self-end text-xl" aria-hidden="true")
                
          div(class="timetable-alerts")
            div(class="timetable-alerts-list hidden p-4 sm:p-6 md:p-8 border-t-8 border-b-8 border-aux-red bg-aux-gray")
            div(class="timetable-alert-empty p-4 sm:p-6 md:p-8 border-t-2 border-b-2 border-aux-gray ")
              | There are no service alerts at this time.

      details(class="border my-6 rounded text-aux-black" aria-labelledby="rt_positions_heading")
        summary(class="list-none flex gap-4 align-middle justify-between py-2 px-5 cursor-pointer")
          
          div(class="flex items-start gap-2 text-base xs:text-lg md:text-xl")

            div(class="pt-0.5")
              i(class="bi bi-bus-front" aria-hidden="true")

            div(class="flex flex-wrap gap-2")
              h2(id="rt_positions_heading" class="mb-0 pt-0.5")= timetablePage.timetable_page_label + ": Active Buses"
              span(id="rt_positions_status" class="rounded-lg border-2 px-2 text-sm xs:text-base md:text-lg" aria-live="polite" aria-atomic="true")="Checking buses..."
          
          div(class="flex items-center justify-center")
            span(class="bi bi-chevron-down justify-self-end text-xl" aria-hidden="true")
        
        div(id="rt_positions_container" class="border-t" aria-label="Real-time bus positions")
          div(class="flex justify-end px-4 mt-4")
            button(id="rt_positions_pause" type="button" class="btn-gray btn-sm flex items-center gap-2" aria-pressed="false")
              i(class="bi bi-pause-fill" aria-hidden="true")
              span Pause Updates
          div(id="rt_positions_list")

    div(id="coa_timetable_menu_schedule" class="mb-12")
    include timetable_menu_route.pug

    div(class="relative")
      a(href="#coa_main_timetable_container" class="absolute top-0 left-0 sr-only focus:not-sr-only" tabindex="0") Skip map, continue to timetable

    div(id="coa_main_map_container" class="mb-12")

      each timetable in timetablePage.consolidatedTimetables
        if config.showMap
          div(class="coa-timetable-map-container relative border border-slate-300 rounded-lg shadow-lg overflow-hidden" id=`coa_map_container_${formatHtmlId(timetable.timetable_id)}` data-direction-id=timetable.direction_id)
            if config.showRouteTitle
              .timetable-label
                h2(class="p-2 bg-aux-gray border-b-2 border-art-blue text-lg xs:text-xl")= `Route Map: ${timetable.timetable_label} | ${timetable.dayListLong === 'Sunday' ? 'Sunday / Holiday' : timetable.dayListLong} Schedule`
            include timetable_map.pug

    div(id="coa_main_timetable_container" class="mb-12")
      include timetable_menu_stops.pug

      each timetable in timetablePage.consolidatedTimetables
        div(id=`timetable_id_${formatHtmlId(timetable.timetable_id)}` class="timetable my-6 border border-slate-300 rounded-lg shadow-lg overflow-hidden" data-day-list=timetable.dayList data-direction-name=timetable.direction_name || timetable.timetable_label data-timetable-id=`${formatHtmlId(timetable.timetable_id)}` data-direction-id=timetable.direction_id data-route-id=timetable.route_ids.join('_') data-stops="timepoints-only")

          if config.showRouteTitle
            div(class="timetable-label p-2 bg-aux-gray border-b-2 border-art-blue")
              div(class="flex flex-col md:flex-row md:justify-between md:items-center md:gap-2")
                h2(class="text-lg xs:text-xl")= `Timetable: ${timetable.timetable_label} | ${timetable.dayListLong === 'Sunday' ? 'Sunday / Holiday' : timetable.dayListLong} Schedule`
                  each note in getNotesForTimetableLabel(timetable.notes)
                    include timetable_note_symbol.pug
                //- a(href="#coa_timetable_menu_schedule" class="text-sm text-gray-600 text-nowrap")
                //-   i(class="bi bi-arrow-down-up" aria-hidden="true")
                //-   span(class="ml-1") Change
              if timetable.service_notes !== null
                .timetable-service-notes= timetable.service_notes
              //- a(href="#coa_timetable_menu_schedule" class="text-sm text-gray-600 text-nowrap")
              //-   i(class="bi bi-arrow-down-up" aria-hidden="true")
              //-   span(class="ml-1") Change direction or schedule
                
          if timetable.orientation === 'horizontal'
            include timetable_horizontal.pug
          else if timetable.orientation === 'hourly'
            include timetable_hourly.pug
          else if timetable.orientation === 'vertical'
            include timetable_vertical.pug

          div(class="timetable-footer p-4 flex flex-col gap-2")
            if hasNotesOrNotices(timetable)
              .notes
                if timetable.requestPickupSymbolUsed
                  .note(id=`note-${timetable.timetable_id}-request-pickup`)= `${config.requestPickupSymbol} = ${config.requestPickupText}`
                if timetable.noPickupSymbolUsed
                  .note(id=`note-${timetable.timetable_id}-no-pickup`)= `${config.noPickupSymbol} = ${config.noPickupText}`
                if timetable.requestDropoffSymbolUsed
                  .note(id=`note-${timetable.timetable_id}-request-dropoff`)= `${config.requestDropoffSymbol} = ${config.requestDropoffText}`
                if timetable.noDropoffSymbolUsed
                  .note(id=`note-${timetable.timetable_id}-no-dropoff`)= `${config.noDropoffSymbol} = ${config.noDropoffText}`
                if timetable.noServiceSymbolUsed
                  .note(id=`note-${timetable.timetable_id}-no-service`)= `${config.noServiceSymbol} = ${config.noServiceText}`
                if timetable.interpolatedStopSymbolUsed
                  .note(id=`note-${timetable.timetable_id}-interpolated-stop`)= `${config.interpolatedStopSymbol} = ${config.interpolatedStopText}`
                each note in _.uniqBy(timetable.notes, 'note_id')
                  .note(id=`note-${timetable.timetable_id}-${note.note_id}`)
                    span= note.symbol 
                    span &nbsp;=&nbsp;
                    span!= md(note.note)

            if config.showCalendarExceptions && timetable.calendarDates.includedDates.length
              .included-dates= `${config.serviceProvidedOnText}: ${timetable.calendarDates.includedDates.join(', ')}`

            if config.showCalendarExceptions && timetable.calendarDates.excludedDates.length
              .excluded-dates= `${config.serviceNotProvidedOnText}: ${timetable.calendarDates.excludedDates.join(', ')}`

      
  script.
    window.holidayDates = !{JSON.stringify(config.holidayDates || [])};

  if config.showMap
    script.
      const timetablePageFromServer = !{JSON.stringify(timetablePage)};
      timetablePageFromServer.dayLists.sort();
      const { gtfsRealtimeUrls, mapStyleUrl, routeData, stopData, pageData: { routeIds, tripIds,  stopIds, geojsons } } = !{JSON.stringify(prepareMapData(timetablePage, config))};
     
      createMaps();
