        //- const initialTimetable = getUrlParam('timetable_id');
        //- if (initialTimetable) {
        //-   jQuery('.timetable').hide();
        //-   jQuery('.coa-timetable-map-container').hide();
        //-   showTimetable(initialTimetable);
        //- } 
      //- });
