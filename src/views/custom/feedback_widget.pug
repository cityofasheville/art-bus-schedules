//- Fixed feedback button (bottom-right)
div(id="feedback-widget" class="fixed bottom-4 right-4 z-[999999]")
  //- Popup
  div(id="feedback-popup" class="hidden absolute bottom-14 right-0 w-48 xs:w-64 bg-white rounded-lg shadow-xl border border-gray-200 px-4 py-6 text-sm")
    p(class="text-aux-black mb-3") How is your experience using the new ART website? Have a good idea? See an opportunity for improvement? We'd love to hear from you!
    a(
      id="feedback-form-link-widget"
      href="https://forms.ashevillenc.gov/form/art-website-feedback"
      class="feedback-form-link inline-flex items-center gap-1 bg-art-blue text-white font-semibold px-4 py-2 rounded-lg hover:bg-art-green hover:text-aux-black transition-colors"
    )
      i(class="bi bi-chat-left-text" aria-hidden="true")
      span Share Your Feedback
    button(
      id="feedback-popup-close"
      class="absolute top-2 right-2 text-gray-400 hover:text-gray-600"
      aria-label="Close feedback popup"
      type="button"
    )
      i(class="bi bi-x-lg" aria-hidden="true")
  //- Trigger button
  button(id="feedback-trigger"
    class="btn-art-green w-12 h-12 rounded-full shadow-lg  transition-colors flex items-center justify-center text-xl border-2 border-art-blue"
    aria-label="Website feedback"
    aria-expanded="false"
    aria-controls="feedback-popup"
    type="button"
  )
    i(class="bi bi-chat-left-text" aria-hidden="true")