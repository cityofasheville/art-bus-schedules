nav#main-nav(class="relative border-b-4 border-art-blue" aria-label="Main Navigation")
  //- img(src="https://www.ashevillenc.gov/wp-content/uploads/2018/10/TransitBus-Feature-72res.jpg" class="absolute" style="width:100%;height:100%;object-fit:cover;")
  div(class="relative flex flex-col lg:flex-row items-end justify-between w-full")
    div(class="flex flex-col sm:flex-row justify-between w-full items-center sm:items-end px-4")
      #header-logo(class="w-full py-4 lg:w-auto text-center sm:text-left")
        a(href="/")
          img(class="inline-block w-64 md:w-80 xl:w-96 h-auto", src=`${config.logo_url}`, alt=`${config.webpageTitle || 'Asheville Transit System '} header logo`)
          //- h1(class="m-0 p-0 sr-only")=`${config.webpageTitle || 'Asheville Transit System '}`
          <span class="sr-only">Asheville Rides Transit Home</span>

      div(class="w-full sm:w-auto flex items-end gap-3 py-4")
        button#hamburger(
          class="lg:hidden text-xl min-w-max text-art-blue font-semibold align-middle"
          aria-expanded="false"
          aria-controls="top-menu-container"
          aria-label="Toggle navigation menu"
        )
          i.bi.bi-list(aria-hidden="true")
          i.bi.bi-x-lg(aria-hidden="true")
          span(class="inline-block pl-2")="Menu"

    div#top-menu-container(class="nav-items hidden lg:block w-full lg:w-auto border-t-4 border-art-blue lg:border-transparent bg-aux-gray lg:bg-transparent p-0")
      ul#menu-main-site-navigation(class="flex flex-col lg:flex-row justify-center lg:justify-start")

        li(class="w-full lg:w-auto lg:min-w-max relative flex flex-col lg:static")
          div(class="border-l-8 border-transparent has-[button:focus]:border-art-blue lg:has-[button:focus]:border-transparent has-[button:hover]:border-art-blue lg:has-[button:hover]:border-transparent w-full flex flex-row group")
            button#submenu-routes-schedules-trigger.dropdown-toggle(
              class="w-full border-t-4 border-transparent lg:hocus:border-art-blue px-4 py-3 flex items-center"
              type="button"
              aria-expanded="false"
              aria-haspopup="true"
              aria-controls="parent_routes_schedules"
              data-dropdown-id="parent_routes_schedules"
            )
              <span class="mr-2">Routes and Schedules</span>
              i(class="bi bi-chevron-down", aria-hidden="true")
              i(class="bi bi-chevron-up", aria-hidden="true")
              span.sr-only show submenu for Routes and Schedules

          //- Mega menu dropdown - full width, below nav bar on desktop
          div#parent_routes_schedules(
            class="dropdown-menu submenu z-50 w-full relative lg:absolute lg:left-0 lg:right-0 lg:top-full bg-aux-gray text-aux-black border-t-2 border-b-2 border-art-blue hidden overflow-hidden"
            aria-labelledby="submenu-routes-schedules-trigger"
          )
            div(class="w-full max-w-screen-xl mx-auto px-4 py-6 overflow-hidden")
              div(class="flex flex-col lg:flex-row gap-6")
                //- Featured tiles section
                ul(class="flex flex-wrap gap-4 lg:gap-6 items-stretch lg:border-r lg:border-slate-300 lg:pr-6 shrink-0 lg:shrink")
                  li(class="min-w-0")
                    a(
                      class="group flex flex-col items-center justify-center w-28 sm:w-36 h-full bg-white rounded-lg shadow-md hover:shadow-lg hover:bg-art-blue transition-all duration-200 text-center p-3 sm:p-4"
                      href="/routes-and-schedules/"
                    )
                      i(class="bi bi-map text-2xl sm:text-4xl text-art-blue group-hover:text-white mb-2 transition-colors" aria-hidden="true")
                      span(class="text-xs sm:text-base font-semibold text-art-blue group-hover:text-white leading-tight transition-colors") All Routes & Schedules
                  li(class="min-w-0")
                    a(
                      class="group flex flex-col items-center justify-center w-28 sm:w-36 h-full bg-white rounded-lg shadow-md hover:shadow-lg hover:bg-art-blue transition-all duration-200 text-center p-3 sm:p-4"
                      href="/holidays/"
                    )
                      i(class="bi bi-calendar-event text-2xl sm:text-4xl text-art-blue group-hover:text-white mb-2 transition-colors" aria-hidden="true")
                      span(class="text-xs sm:text-base font-semibold text-art-blue group-hover:text-white leading-tight transition-colors") Holidays
                  li(class="min-w-0")
                    a(
                      class="group flex flex-col items-center justify-center w-28 sm:w-36 h-full bg-white rounded-lg shadow-md hover:shadow-lg hover:bg-art-blue transition-all duration-200 text-center p-3 sm:p-4"
                      href="https://www.buncombenc.gov/605/Transportation"
                      rel="noreferrer"
                    )
                      i(class="bi bi-universal-access text-2xl sm:text-4xl text-art-blue group-hover:text-white mb-2 transition-colors" aria-hidden="true")
                      span(class="text-xs sm:text-base font-semibold text-art-blue group-hover:text-white leading-tight transition-colors") Paratransit
                        i(class="bi bi-box-arrow-up-right ml-1 text-xs" aria-hidden="true")
                      span(class="sr-only") opens external site

                //- Routes grid section - dynamically generated from route data
                div(class="flex-1 min-w-0")
                  span(id="individual_routes_heading" class="inline-block text-sm font-semibold text-slate-600 uppercase tracking-wide mb-3") Individual Routes
                  ul(class="list-none flex flex-wrap gap-2" aria-describedby="individual_routes_heading")
                    - const routes = config.timetablePage && config.timetablePage.routes ? config.timetablePage.routes : []
                    - const sortedRoutes = routes.slice().sort((a, b) => (a.route_short_name || '').localeCompare(b.route_short_name || '', undefined, {numeric: true}))
                    each route in sortedRoutes
                      - const bgColor = route.route_color ? `#${route.route_color}` : '#005daa'
                      - const textColor = route.route_text_color ? `#${route.route_text_color}` : '#ffffff'
                      li
                        a(
                          class="route-color-swatch-large hover:ring-2 hover:ring-art-green hover:ring-offset-2 transition-all"
                          style=`background-color: ${bgColor}; color: ${textColor};`
                          href=`/${route.route_short_name}/`
                        )= route.route_short_name

