nav#main-nav(class="relative border-b-4 border-art-blue" aria-label="Main Navigation")
  //- img(src="https://www.ashevillenc.gov/wp-content/uploads/2018/10/TransitBus-Feature-72res.jpg" class="absolute" style="width:100%;height:100%;object-fit:cover;")

  div(class="relative flex flex-col lg:flex-row items-end justify-between w-full")
    div(class="flex justify-between w-full items-end px-4")
      #header-logo(class="w-full py-4 lg:w-auto text-center sm:text-left")
        a(href="/")
          img(class="inline-block w-64 md:w-80 xl:w-96 h-auto", src=`${config.logo_url}`, alt=`${config.webpageTitle || 'Asheville Transit System '} logo`)
          h1(class="m-0 p-0 sr-only")=`${config.webpageTitle || 'Asheville Transit System '}`

      div(class="lg:hidden w-full sm:w-auto  flex items-end justify-end sm:justify-end py-4")
        button#hamburger(class="min-w-max text-art-blue font-semibold align-middle" aria-expanded="false")
          i.bi.bi-list.text-xl(aria-hidden="true")
          i.bi.bi-x-lg.text-xl(aria-hidden="true")
          span(class="inline-block text-xl pl-2")="Menu"

    div#top-menu-container(class="nav-items relative hidden lg:block w-full lg:w-auto border-t-4 border-art-blue lg:border-transparent bg-aux-gray lg:bg-transparent p-0")
      ul#menu-main-site-navigation(class="flex flex-col lg:flex-row justify-center lg:justify-start")

        li(class="w-full lg:w-auto min-w-max relative flex flex-col")
          div(class="border-l-8 border-transparent has-[button:focus]:border-art-blue lg:has-[button:focus]:border-transparent has-[button:hover]:border-art-blue lg:has-[button:hover]:border-transparent w-full flex flex-row group")
            //- a(class="w-full px-4 border-t-8 border-transparent lg:hocus:border-art-blue py-3", href="#") Fares and Passes
            button#submenu-routes-schedules-trigger.dropdown-toggle(
              class="w-full border-t-8 border-transparent lg:hocus:border-art-blue px-4 py-3 flex items-center"
              type="button"
              aria-expanded="false"
              aria-haspopup="true"
              aria-controls="parent_routes_schedules"
              data-dropdown-id="parent_routes_schedules"
            )
              <span class="mr-2">Routes and Schedules</span>
              i(class="bi bi-chevron-down", aria-hidden="true")
              i(class="bi bi-chevron-up", aria-hidden="true")
              span.sr-only show submenu for Routes and Schedules

          ul#parent_routes_schedules(
            class="w-full dropdown-menu submenu z-50 min-w-max lg:rounded-b-sm lg:border-b lg:border-r lg:border-l lg:border-ar-blue relative lg:absolute lg:top-16 lg:right-0 bg-aux-gray text-ar-slate size-max hidden"
            aria-labelledby="submenu-routes-schedules-trigger"
          )
            li(class="relative flex flex-col border-b border-slate-400 lg:border-transparent")
              div(class="border-l-8 border-transparent has-[a:focus]:border-art-blue has-[a:hover]:border-art-blue flex flex-row group")
                a(class="w-full px-4 py-3 pl-8 lg:pl-4", href="/routes-and-schedules/") All Routes and Schedules
            li(class="relative flex flex-col border-b border-slate-400 lg:border-transparent")
              div(class="border-l-8 border-transparent has-[a:focus]:border-art-blue has-[a:hover]:border-art-blue flex flex-row group")
                a(class="w-full px-4 py-3 pl-8 lg:pl-4", href="https://www.buncombenc.gov/605/Transportation" rel="noreferrer") Paratransit
                  i(class="bi bi-box-arrow-up-right ml-3", aria-hidden="true")
                  span(class="sr-only") opens external site

        li(class="w-full lg:w-auto min-w-max relative flex flex-col")
          div(class="border-l-8 border-transparent has-[button:focus]:border-art-blue lg:has-[button:focus]:border-transparent has-[button:hover]:border-art-blue lg:has-[button:hover]:border-transparent w-full flex flex-row group")
            //- a(class="w-full px-4 border-t-8 border-transparent lg:hocus:border-art-blue py-3", href="#") Fares and Passes
            button#submenu-fares-passes-trigger.dropdown-toggle(
              class="w-full border-t-8 border-transparent lg:hocus:border-art-blue px-4 py-3 flex items-center"
              type="button"
              aria-expanded="false"
              aria-haspopup="true"
              aria-controls="parent_fares_passes"
              data-dropdown-id="parent_fares_passes"
            )
              <span class="mr-2">Fares and Passes</span>
              i(class="bi bi-chevron-down", aria-hidden="true")
              i(class="bi bi-chevron-up", aria-hidden="true")
              span.sr-only show submenu for Fares and Passes

          ul#parent_fares_passes(
            class="w-full dropdown-menu submenu z-50 min-w-max lg:rounded-b-sm lg:border-b lg:border-r lg:border-l lg:border-ar-blue relative lg:absolute lg:top-16 lg:right-0 bg-aux-gray text-ar-slate size-max hidden"
            aria-labelledby="submenu-fares-passes-trigger"
          )
            li(class="relative flex flex-col border-b border-slate-400 lg:border-transparent")
              div(class="border-l-8 border-transparent has-[a:focus]:border-art-blue has-[a:hover]:border-art-blue flex flex-row group")
                a(class="w-full px-4 py-3 pl-8 lg:pl-4", href="/fares-and-passes/") Transit Fares and Passes
            li(class="relative flex flex-col border-b border-slate-400 lg:border-transparent")
              div(class="border-l-8 border-transparent has-[a:focus]:border-art-blue has-[a:hover]:border-art-blue flex flex-row group")
                a(class="w-full px-4 py-3 pl-8 lg:pl-4", href="/passport-program/") Passport Program

        li(class="min-w-max relative flex flex-col border-b-2 border-slate-400 lg:border-transparent")
          div(class="border-l-8 border-transparent has-[a:focus]:border-art-blue lg:has-[a:focus]:border-transparent has-[a:hover]:border-art-blue lg:has-[a:hover]:border-transparent w-full flex flex-row group")
            a(class="w-full px-4 border-t-8 border-transparent lg:hocus:border-art-blue py-3", href="#") Alerts

        li(class="w-full lg:w-auto min-w-max relative flex flex-col")
          div(class="border-l-8 border-transparent has-[button:focus]:border-art-blue lg:has-[button:focus]:border-transparent has-[button:hover]:border-art-blue lg:has-[button:hover]:border-transparent w-full flex flex-row group")
            //- a(class="w-full px-4 border-t-8 border-transparent lg:hocus:border-art-blue py-3", href="#") Rider Tools
            button#submenu-rider-tools-trigger.dropdown-toggle(
              class="w-full border-t-8 border-transparent lg:hocus:border-art-blue px-4 py-3 flex items-center"
              type="button"
              aria-expanded="false"
              aria-haspopup="true"
              aria-controls="parent_rider_tools"
              data-dropdown-id="parent_rider_tools"
            )
              <span class="mr-2">Rider Tools</span>
              i(class="bi bi-chevron-down", aria-hidden="true")
              i(class="bi bi-chevron-up", aria-hidden="true")
              span.sr-only show submenu for Rider Tools

          ul#parent_rider_tools(
            class="w-full dropdown-menu submenu z-50 min-w-max lg:rounded-b-sm lg:border-b lg:border-r lg:border-l lg:border-ar-blue relative lg:absolute lg:top-16 lg:right-0 bg-aux-gray text-ar-slate size-max hidden"
            aria-labelledby="submenu-rider-tools-trigger"
          )
            li(class="relative flex flex-col border-b border-slate-400 lg:border-transparent")
              div(class="border-l-8 border-transparent has-[a:focus]:border-art-blue has-[a:hover]:border-art-blue flex flex-row group")
                a(class="w-full px-4 py-3 pl-8 lg:pl-4", href="/how-to-ride/") How To Ride
            li(class="relative flex flex-col border-b border-slate-400 lg:border-transparent")
              div(class="border-l-8 border-transparent has-[a:focus]:border-art-blue has-[a:hover]:border-art-blue flex flex-row group")
                a(class="w-full px-4 py-3 pl-8 lg:pl-4", href="/trip-planner/") Trip Planner
            li(class="relative flex flex-col border-b border-slate-400 lg:border-transparent")
              div(class="border-l-8 border-transparent has-[a:focus]:border-art-blue has-[a:hover]:border-art-blue flex flex-row group")
                a(class="w-full px-4 py-3 pl-8 lg:pl-4", href="/policies-and-tips/") Policies and Tips
            li(class="relative flex flex-col border-b border-slate-400 lg:border-transparent")
              div(class="border-l-8 border-transparent has-[a:focus]:border-art-blue has-[a:hover]:border-art-blue flex flex-row group")
                a(class="w-full px-4 py-3 pl-8 lg:pl-4", href="/bikes-on-buses/") Bikes on Buses
            li(class="relative flex flex-col")
              div(class="border-l-8 border-transparent has-[a:focus]:border-art-blue has-[a:hover]:border-art-blue flex flex-row group")
                a(class="w-full px-4 py-3 pl-8 lg:pl-4", href="/ada/") ADA, Wheelchairs and Service Animals

        li(class="min-w-max relative flex flex-col border-b-2 border-slate-400 lg:border-transparent")
          div(class="border-l-8 border-transparent has-[a:focus]:border-art-blue lg:has-[a:focus]:border-transparent has-[a:hover]:border-art-blue lg:has-[a:hover]:border-transparent w-full flex flex-row group")
            a(class="w-full px-4 border-t-8 border-transparent lg:hocus:border-art-blue py-3", href="/contact/") Contact


