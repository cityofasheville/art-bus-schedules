include formatting_functions.pug

.relative.w-full.h-full.flex.flex-col
  img(src="https://www.ashevillenc.gov/wp-content/uploads/2018/10/TransitBus-Feature-72res.jpg" class="absolute" style="width:100%;height:100%;object-fit:cover;")

  div(class="w-full px-4")
    div(class="relative z-10 max-w-screen-sm lg:max-w-screen-md min-h-64 mx-auto bg-aux-gray border rounded shadow-lg p-0 my-12")
      h1(class="p-4 px-4 bg-art-green text-white text-2xl mt-0 mb-4 rounded-t-sm")="Real-time Departures"
      div(class="p-4")
        fieldset#departure_interface_selector.px-4.border.shadow-md
          legend="Find real-time departures for a stop"
          div(class=`w-full grid grid-cols-3 btn-group`)
            label.relative.btn-gray.text-center.cursor-pointer(for="radio_search_stop")
              input(class="opacity-0 absolute top-0 left-0" type="radio" name="departure_interface" value="search_stop" checked="true" id="radio_search_stop")
              span= "By Stop"
            label.relative.btn-gray.text-center.cursor-pointer(for="radio_favorites")
              input(class="opacity-0 absolute top-0 left-0" type="radio" name="departure_interface" value="favorites" checked=false id="radio_favorites")
              span= "Favorites"
            label.relative.btn-gray.text-center.cursor-pointer(for="radio_by_route")
              input(class="opacity-0 absolute top-0 left-0" type="radio" name="departure_interface" value="by_route" checked=false id="radio_by_route")
              span= "By Route"
        p.mb-4="Select a stop to see real time departure information"
        select#stop-select-dropdown.border.p-2(class="max-w-full" onchange="handleStopSelection(event)")
          option(value="") Select a stop
          each stop in config.timetablePage.stops
            option(value=stop.stop_id)=`${stop.stop_name} (${stop.stop_code})`
        output#results-container.max-w-screen-lg.mx-auto.block.py-6 

  footer
    p!=config.wordpress.transitConnect.what_we_do

script.
    window.config = !{JSON.stringify(config)};
    const gtfsRealtimeUrls = {realtimeTripUpdates: window.config.agencies[0].realtimeTripUpdates, realtimeVehiclePositions: window.config.agencies[0].realtimeVehiclePositions};
    const directions = window.config.timetablePage.directions;
    const routeIds = window.config.timetablePage.routes.map(route => route.route_id);
    const routeData = window.config.timetablePage.routes.reduce((accumulator, route) => {
      accumulator[route.route_id] = {
        route_id: route.route_id,
        route_short_name: route.route_short_name,
        route_long_name: route.route_long_name,
        route_desc: route.route_desc,
        route_color: route.route_color,
        route_text_color: route.route_text_color
      };
      return accumulator;
    }, {});
    const tripIds = window.config.timetablePage.trips.map(trip => trip.trip_id);
    const tripData = window.config.timetablePage.trips.reduce((accumulator, trip) => {
      accumulator[trip.trip_id] = {
        trip_id: trip.trip_id,
        route_id: trip.route_id,
        trip_headsign: trip.trip_headsign,
        direction_id: trip.direction_id
      };
      return accumulator;
    }, {});
    const stopData = window.config.timetablePage.stops.reduce((accumulator, stop) => {
      accumulator[stop.stop_id] = {
        stop_id: stop.stop_id,
        stop_code: stop.stop_code,
        stop_name: stop.stop_name,
        stop_lat: stop.stop_lat,
        stop_lon: stop.stop_lon
      };
      return accumulator;
    }, {});
    const timetableData = window.config.timetablePage.consolidatedTimetables;
    console.log('Data:', window.config);
    $(document).ready(function() {
      $('#stop-select-dropdown').select2({
        width: 'element' 
      });
      const initialStopId = getUrlParam('stop_id');
      console.log('Initial stop ID from URL param:', initialStopId);
      if (initialStopId) {
        $('#stop-select-dropdown').val(initialStopId).trigger('change');
        fetchRealtimeDeparturesForStop(initialStopId);
      } 
