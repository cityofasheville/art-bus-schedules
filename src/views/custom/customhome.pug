script.
    window.config = !{JSON.stringify(config)};
    const routeDirectionStops = !{JSON.stringify(routeDirectionStops)};
    const gtfsRealtimeUrls = {realtimeTripUpdates: window.config.agencies[0].realtimeTripUpdates, realtimeVehiclePositions: window.config.agencies[0].realtimeVehiclePositions, realtimeAlerts: window.config.agencies[0].realtimeAlerts};
    const directions = window.config.timetablePage.directions;
    const routeIds = window.config.timetablePage.routes.map(route => route.route_id);
    const routeData = window.config.timetablePage.routes.reduce((accumulator, route) => {
      accumulator[route.route_id] = {
        route_id: route.route_id,
        route_short_name: route.route_short_name,
        route_long_name: route.route_long_name,
        route_desc: route.route_desc,
        route_color: route.route_color,
        route_text_color: route.route_text_color
      };
      return accumulator;
    }, {});
    const tripIds = window.config.timetablePage.trips.map(trip => trip.trip_id);
    const tripData = window.config.timetablePage.trips.reduce((accumulator, trip) => {
      accumulator[trip.trip_id] = {
        trip_id: trip.trip_id,
        route_id: trip.route_id,
        trip_headsign: trip.trip_headsign,
        direction_id: trip.direction_id
      };
      return accumulator;
    }, {});
    const stopIds = window.config.timetablePage.stops.map(stop => stop.stop_id);
    const stopData = window.config.timetablePage.stops.reduce((accumulator, stop) => {
      accumulator[stop.stop_id] = {
        stop_id: stop.stop_id,
        stop_code: stop.stop_code,
        stop_name: stop.stop_name,
        stop_lat: stop.stop_lat,
        stop_lon: stop.stop_lon
      };
      return accumulator;
    }, {});
    const timetableData = window.config.timetablePage.consolidatedTimetables;
    console.log('Data:', window.config);
    console.log('routeDirectionStops mapping:', routeDirectionStops);

    // Populate route dropdown on page load
    function initRouteDropdown() {
      const routeDropdown = $('#route-select-dropdown');
      const sortedRoutes = Object.values(routeData).sort((a, b) => 
        (a.route_short_name || '').localeCompare(b.route_short_name || '', undefined, {numeric: true})
      );
      sortedRoutes.forEach(route => {
        const displayName = route.route_short_name 
          ? `${route.route_short_name} - ${route.route_long_name}` 
          : route.route_long_name;
        routeDropdown.append(`<option value="${route.route_id}">${displayName}</option>`);
      });
    }

    // Handle route selection - populate directions
    function onRouteChange() {
      const routeId = $('#route-select-dropdown').val();
      const directionDropdown = $('#direction-select-dropdown');
      const stopDropdown = $('#stop-by-route-select-dropdown');

      directionDropdown.html('<option value="">Select a direction</option>');
      stopDropdown.html('<option value="">Select a stop</option>').prop('disabled', true);

      if (!routeId) {
        directionDropdown.prop('disabled', true);
        return;
      }

      const directionsForRoute = directions.filter(dir => dir.route_id === routeId);
      directionsForRoute.forEach(dir => {
        directionDropdown.append(`<option value="${dir.direction_id}">${dir.direction}</option>`);
      });
      directionDropdown.prop('disabled', false);
    }

    // Handle direction selection - populate stops
    function onDirectionChange() {
      const routeId = $('#route-select-dropdown').val();
      const directionId = $('#direction-select-dropdown').val();
      const stopDropdown = $('#stop-by-route-select-dropdown');

      stopDropdown.html('<option value="">Select a stop</option>');

      if (!routeId || !directionId) {
        stopDropdown.prop('disabled', true);
        return;
      }

      // Use pre-built mapping from server-side
      const key = `${routeId}_${directionId}`;
      const stops = routeDirectionStops[key] || [];
      
      stops.forEach(stop => {
        const displayName = stop.stop_code 
          ? `${stop.stop_name} (${stop.stop_code})` 
          : stop.stop_name;
        stopDropdown.append(`<option value="${stop.stop_id}">${displayName}</option>`);
      });
      
      stopDropdown.prop('disabled', false);
    }

    // Handle stop selection from By Route interface
    function onStopByRouteChange() {
      const stopId = $('#stop-by-route-select-dropdown').val();
      if (stopId) {
        setUrlParam('stop_id', stopId);
        fetchRealtimeDeparturesForStop(stopId);
      }
    }

    $(document).ready(function() {
      // Initialize By Route dropdowns
      initRouteDropdown();
      $('#route-select-dropdown').on('change', onRouteChange);
      $('#direction-select-dropdown').on('change', onDirectionChange);
      $('#stop-by-route-select-dropdown').on('change', onStopByRouteChange);
      $('#stop-select-dropdown').select2({
        //- width: 'element',
        width: '100%'
      });
      $('#favorite-stop-select-dropdown').select2({
        //- width: 'element',
        width: '100%' 
      });

      // prevent select2 from auto-focusing the search input when the dropdown opens, which causes mobile keyboard to pop up immediately
      // need to support tab navigation to the search input. the input is not naturally next in the tab order. Maybe we only want to prevent auto-focus if the user is not using keyboard navigation?

      //- $('#stop-select-dropdown').on('select2:open', function() {
      //-   $('.select2-search input').prop('focus', 0);
      //- });          
      //- $('#favorite-stop-select-dropdown').on('select2:open', function() {
      //-   $('.select2-search input').prop('focus', 0);
      //- });

      const initialStopId = getUrlParam('stop_id');
      console.log('Initial stop ID from URL:', initialStopId);
      if (initialStopId) {
        console.log('Setting initial stop selection to:', initialStopId);
        $('#stop-select-dropdown').val(initialStopId).trigger('change');
        $("#favorite-stop-select-dropdown").select2("val", "");
        //- $('#favorite-stop-select-dropdown').val('').trigger('change');
        //- $('#favorite-stop-select-dropdown').val(initialStopId);
        fetchRealtimeDeparturesForStop(initialStopId);
      } else {
        //- $("#stop-select-dropdown").select2("val", "");
        //- $("#favorite-stop-select-dropdown").select2("val", "");

        //- $('#stop-select-dropdown').val('').trigger('change');
        //- $('#favorite-stop-select-dropdown').val('').trigger('change');
      }
    });
