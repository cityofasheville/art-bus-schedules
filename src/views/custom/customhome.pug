include formatting_functions.pug
include server_computed_data.pug

div(class="")
  h1(class="sr-only")=pageTitleToUse

  div(class="w-full min-h-128 relative flex-grow flex items-start justify-center")
    img(src="https://www.ashevillenc.gov/wp-content/uploads/2018/10/TransitBus-Feature-72res.jpg" class="absolute" alt="Transit Bus" style="width:100%;height:100%;object-fit:cover;")

    div(class="w-full max-w-7xl mx-6 flex items-center justify-center lg:justify-center  my-12")
      include realtimedepartures_widget.pug

  div(class="w-full bg-art-green p-6 lg:px-12 lg:py-16")
    div(class="w-full max-w-7xl mx-auto ")

      div(class="grid grid-cols-1 md:grid-cols-3 gap-8")

        div(class="bg-white rounded-lg shadow-lg p-6 flex flex-col items-center")
          i(class="bi bi-map text-4xl text-art-green mb-4" style="font-size: 4rem;" aria-hidden="true")
          h3(class="text-xl font-semibold mb-2") Routes and Schedules
          p(class="mb-6") Find schedule information for any route in the system.
          a(href="/routes-and-schedules/" class="btn-blue") Find Your Route

        div(class="bg-white rounded-lg shadow-lg p-6 flex flex-col items-center")
          i(class="bi bi-bus-front text-4xl text-art-green mb-4" style="font-size: 4rem;" aria-hidden="true")
          h3(class="text-xl font-semibold mb-2") Realtime departures
          p(class="mb-6") Save your favorite stops for quick access to departure times.
          a(href="/real-time-departures/" class="btn-blue") Get departure times

        div(class="bg-white rounded-lg shadow-lg p-6 flex flex-col items-center")
          i(class="bi bi-ticket-perforated text-4xl text-art-green mb-4" style="font-size: 4rem;" aria-hidden="true")
          h3(class="text-xl font-semibold mb-2") Trip Planner
          p(class="mb-6") Know how to get from point A to point B.
          a(href="/trip-planner/" class="btn-blue") Plan your trip

  div(class="w-full bg-aux-red p-6 lg:p-12 ")
    div(class="w-full bg-aux-gray max-w-7xl mx-auto p-6 rounded-lg")
      include servicealerts_widget.pug


  div(class="w-full bg-aux-gray p-6 lg:px-12 lg:py-16")
    div(class="w-full max-w-7xl mx-auto ")

      h2(class="p-4 px-4 text-2xl m-0")
        i(class="inline-block bi bi-newspaper mr-2" aria-hidden="true")
        span(class="inline-block")="Recent News"

      div(class="grid grid-cols-1 md:grid-cols-3 gap-8")

        each post in config.wordpress.transitNews
          - const media = post._embedded && post._embedded['wp:featuredmedia'] && post._embedded['wp:featuredmedia'][0]
          - const imageUrl = media && media.media_details && media.media_details.sizes && media.media_details.sizes.medium_large ? media.media_details.sizes.medium_large.source_url : (media && media.source_url ? media.source_url : 'https://www.ashevillenc.gov/wp-content/uploads/2018/10/P1220005-768x432.jpg')
          - const postDate = new Date(post.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
          div(class="bg-white rounded-lg shadow-lg flex flex-col")
            div(class="relative aspect-video w-full")
              img(src=imageUrl alt="" class="absolute rounded-t-lg" style="width:100%;height:100%;object-fit:cover;")
            div(class="p-6 flex flex-col flex-grow")
              a(href=post.link class="text-xl font-semibold mb-2 hover:underline")!= post.title.rendered
              div(class="mb-4 flex-grow")!= post.excerpt.rendered
              p(class="text-sm italic text-gray-500") Published on #{postDate}



