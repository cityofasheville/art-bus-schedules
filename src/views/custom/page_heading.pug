mixin page_heading(title, maxWidth, headingId)
  - maxWidth = maxWidth || 'max-w-screen-lg'
  - headingId = headingId || 'page_heading_text'
  div(class="relative w-full bg-art-blue border-b-4 border-art-green bg-cover bg-center" style="background-image: url(https://www.ashevillenc.gov/wp-content/uploads/2026/03/ART-blue-asheville-map-1600.jpg)")
    div(class=`w-full ${maxWidth} mx-auto p-4 z-10`)
      h1(id=headingId class="py-4 text-aux-white text-2xl sm:text-4xl lg:text-5xl m-0")
        span!=title