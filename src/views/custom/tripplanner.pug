include formatting_functions.pug

include page_heading
+page_heading(pageTitleToUse, 'max-w-screen-xl')

div(class="w-full min-h-128 bg-gradient-to-r from-art-blue/30 via-art-white to-art-green/20 relative flex-grow flex items-start justify-center px-4")

  div(class="relative z-10 w-full max-w-3xl min-h-64 mx-auto bg-aux-white border rounded-lg shadow-lg overflow-hidden my-12")
    h2(class="p-4 px-4 text-aux-black text-lg xs:text-xl sm:text-2xl m-0 rounded-t-sm bg-art-green")
      i(class="inline-block bi bi-compass mr-2" aria-hidden="true")
      span(class="inline-block")="Trip Planner"
    form(id="trip_planner_form" class="py-4")
      fieldset#trip_planner_fieldset.p-4
        legend="Plan your trip with Google Maps"

        div.autocomplete-wrapper.relative.mb-4
          label(for="trip_planner_input_source") Start Address (Origin)
          input(type="text" id="trip_planner_input_source" name="trip_planner_input_source" class="w-full border p-2" placeholder="36 Montford Ave" required autocomplete="off" aria-autocomplete="list" aria-controls="trip_planner_input_source_suggestions")
          ul#trip_planner_input_source_suggestions.autocomplete-suggestions(role="listbox" aria-label="Address suggestions")

        div.autocomplete-wrapper.relative.mb-4
          label(for="trip_planner_input_destination") End Address (Destination)
          input(type="text" id="trip_planner_input_destination" name="trip_planner_input_destination" class="w-full border p-2" placeholder="70 Court Plaza" required autocomplete="off" aria-autocomplete="list" aria-controls="trip_planner_input_destination_suggestions")
          ul#trip_planner_input_destination_suggestions.autocomplete-suggestions(role="listbox" aria-label="Address suggestions")

        div
          label(for="trip_planner_input_date") Departure Day
          input(type="date" id="trip_planner_input_date" class="w-full border p-2 mb-4" name="trip_planner_input_date" )

        div
          label(for="trip_planner_input_time") Departure Time
          input(type="time" id="trip_planner_input_time" class="w-full border p-2 mb-4" name="trip_planner_input_time" )

        div
          label(for="trip_planner_input_trip_preference") Trip Preference
          select(id="trip_planner_input_trip_preference" class="w-full border p-2 mb-4" name="trip_planner_input_trip_preference" )
            option(value="") Best route
            option(value="fewer_transfers") Fewer transfers
            option(value="less_walking") Less walking

        button(type="submit" class="btn-blue") Get Directions with Google Maps

style.
  .autocomplete-suggestions {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    z-index: 1000;
    background: white;
    border: 1px solid #ccc;
    border-top: none;
    border-radius: 0 0 4px 4px;
    max-height: 250px;
    overflow-y: auto;
    list-style: none;
    margin: 0;
    padding: 0;
    display: none;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
  }
  .autocomplete-suggestions.show {
    display: block;
  }
  .autocomplete-suggestions li {
    padding: 10px 12px;
    cursor: pointer;
    border-bottom: 1px solid #eee;
  }
  .autocomplete-suggestions li:last-child {
    border-bottom: none;
  }
  .autocomplete-suggestions li:hover,
  .autocomplete-suggestions li.highlighted {
    background-color: #e8f4fc;
  }
  .autocomplete-suggestions li[aria-selected="true"] {
    background-color: #d0e8f7;
  }
  .autocomplete-loading {
    padding: 10px 12px;
    color: #666;
    font-style: italic;
  }
  .autocomplete-no-results {
    padding: 10px 12px;
    color: #999;
  }
