include formatting_functions.pug
-const alphabetical_stops = [...config.timetablePage.stops].sort((a, b) => a.stop_name.localeCompare(b.stop_name));

//- .relative.w-full.h-full.flex.flex-col
div(class="pt-12 max-w-screen-2xl mx-auto")
  h1(class="sr-only")=pageTitleToUse
  //- img(src="https://www.ashevillenc.gov/wp-content/uploads/2018/10/TransitBus-Feature-72res.jpg" class="absolute" style="width:100%;height:100%;object-fit:cover;")

  div(class="w-full px-4")

    div(class="relative z-10 w-full max-w-screen-sm lg:max-w-screen-md min-h-64 mx-auto bg-aux-gray border rounded shadow-lg p-0 mb-6 lg:mb-0")
      h2(class="p-4 px-4 text-art-blue text-2xl m-0 rounded-t-sm bg-art-green/10")
        i(class="inline-block bi bi-compass mr-2" aria-hidden="true")
        span(class="inline-block")="Trip Planner"
      div(class="p-4")
        form(id="trip_planner_form")
          fieldset#trip_planner_fieldset.p-4.border.shadow-md
            legend="Plan your trip with Google Maps"
            //- input(type="text" id="trip_planner_input_source" name="trip_planner_input_source" class="w-full border p-2" placeholder="Enter your starting location or destination")
            //- input(type="text" id="trip_planner_input_destination" name="trip_planner_input_destination" class="w-full border p-2 mt-4" placeholder="Enter your destination or starting location")
            //- button(type="submit" id="trip_planner_submit_button" class="btn-blue")="Plan My Trip"

            div
              label(for="trip_planner_input_source") Start Address (Origin)
              input(type="text" id="trip_planner_input_source" name="trip_planner_input_source" class="w-full border p-2" placeholder="36 Montford Ave" required)

            div
              label(for="trip_planner_input_destination") End Address (Destination)
              input(type="text" id="trip_planner_input_destination" name="trip_planner_input_destination" class="w-full border p-2" placeholder="70 Court Plaza" required)

            div
              label(for="trip_planner_input_date") Departure Day
              input(type="date" id="trip_planner_input_date" class="w-full border p-2" name="trip_planner_input_date" )

            div
              label(for="trip_planner_input_time") Departure Time
              input(type="time" id="trip_planner_input_time" class="w-full border p-2" name="trip_planner_input_time" )

            div
              label(for="trip_planner_input_trip_preference") Trip Preference
              select(id="trip_planner_input_trip_preference" class="w-full border p-2" name="trip_planner_input_trip_preference" )
                option(value="") Best route
                option(value="fewer_transfers") Fewer transfers
                option(value="less_walking") Less walking

            button(type="submit" class="btn-blue") Get Directions

script.
    $(document).ready(function() {
      $('#trip_planner_form').on('submit', function(e) {
        e.preventDefault();
        const source = $('#trip_planner_input_source').val();
        const destination = $('#trip_planner_input_destination').val();
        const departure_date = $('#trip_planner_input_date').val() ? $('#trip_planner_input_date').val() : new Date().toISOString().split('T')[0];
        const departure_time = $('#trip_planner_input_time').val() ? $('#trip_planner_input_time').val() : new Date().toTimeString().split(' ')[0].substring(0,5);
        const tripPreference = $('#trip_planner_input_trip_preference').val() ? $('#trip_planner_input_trip_preference').val() : "1";

        const departureDateTime = new Date(`${departure_date}T${departure_time}`);
        const unixTimestamp = Math.floor(departureDateTime.getTime() / 1000);

        const baseUrl = "https://www.google.com/maps/dir/";
        //- const baseUrl = "https://www.google.com/maps/";

        //- May need to give up on departure_time and route options and let user adjust in Google Maps directly

        const params = new URLSearchParams();
        params.append("api", "1");
        params.append("travelmode", "transit");
        params.append("origin", source);
        params.append("destination", destination);
        params.append("departure_time", unixTimestamp);

        if (tripPreference) {
          params.append("transit_routing_preference", tripPreference);
        }

        const finalUrl = `${baseUrl}?${params.toString()}`;

        console.log(`Generated Google Maps URL: ${finalUrl}`);

        window.open(finalUrl, "_blank");

      });
      console.log('Trip Planner page loaded');
    });
