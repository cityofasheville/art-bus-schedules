div(id="container_real_time_departures" class="w-full max-w-[24rem] sm:max-w-[32rem] md:max-w-[40rem] lg:max-w-[48rem] z-10")
  div(class="w-full min-h-64 z-10 bg-aux-gray border rounded-lg shadow-lg p-0")
    h2(id="tr_departures_heading" class="p-4 px-4 text-white text-2xl m-0 rounded-t-lg bg-art-green")
      i(class="inline-block bi bi-clock-history mr-2" aria-hidden="true")
      span(class="inline-block")="Real-time Departures"
    div(class="p-4")
      fieldset(id="departure_interface_selector" class="radio-group mb-4")
        legend(class="sr-only")="Find real-time departures"
        div(class=`w-full grid grid-cols-3 btn-group rounded-xl` role="radiogroup" aria-label="Select interface for finding real-time departures")
          label.relative.btn-gray.text-center.cursor-pointer(for="radio_search_stop")
            input(class="opacity-0 absolute top-0 left-0" type="radio" name="departure_interface" value="search_stop" checked="true" id="radio_search_stop")
            span= "By Stop"
          label.relative.btn-gray.text-center.cursor-pointer(for="radio_favorites")
            input(class="opacity-0 absolute top-0 left-0" type="radio" name="departure_interface" value="favorites" checked=false id="radio_favorites")
            span= "Favorites"
          label.relative.btn-gray.text-center.cursor-pointer(for="radio_choose_route")
            input(class="opacity-0 absolute top-0 left-0" type="radio" name="departure_interface" value="choose_route" checked=false id="radio_choose_route")
            span= "By Route"

      div(id="container_search_stop" class="departure-interface mb-4")
        label(for="stop-select-dropdown" class="block mb-2") Select a stop to see real time departure information
        select#stop-select-dropdown.border(class="max-w-full" aria-label="Select a stop to see real time departure information")
          option(value="") Select a stop
          each stop in alphabetical_stops
            option(value=stop.stop_id)=`${stop.stop_name} (${stop.stop_code})`

      div(id="container_favorites" class="departure-interface mb-4")
        div(id="favorite_stops_select_container" class="mb-4")
          label(for="favorite-stop-select-dropdown" class="block mb-2") Select one of your favorite stops to see real time departure information
          select#favorite-stop-select-dropdown.border(class="max-w-full" aria-label="Select one of your favorite stops to see real time departure information")
            option(value="") Select a favorite stop
        div(id="favorite_instructions_container" class="mt-4")="Mark at least one favorite stop by clicking the star icon next to the stop name in the results."
            
      div(id="container_choose_route" class="departure-interface mb-4")
        p.mb-4="Choose a route, direction, and stop to see real time departure information"
        
        div.mb-4
          label(for="route-select-dropdown") Route
          select#route-select-dropdown.border.p-2.w-full
            option(value="") Select a route

        div.mb-4
          label(for="direction-select-dropdown") Direction
          select#direction-select-dropdown.border.p-2.w-full(disabled)
            option(value="") Select a direction

        div.mb-4
          label(for="stop-by-route-select-dropdown") Stop
          select#stop-by-route-select-dropdown.border.p-2.w-full(disabled)
            option(value="") Select a stop

      output(id="results-container" class="max-w-screen-lg mx-auto block")