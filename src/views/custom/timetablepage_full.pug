extends layout
block content
  include timetablepage.pug

block append extraHeader

  script(src=`/vendor/js/jquery.min.3.7.1.js`)
  script(src=`/vendor/js/tom-select.complete.min.2.6.0.js`)
  
  if ((config.hasGtfsRealtimeVehiclePositions || config.hasGtfsRealtimeTripUpdates) && config.showMap) || config.hasGtfsRealtimeAlerts
    script(src=`/js/pbf.js`)
    script(src=`/js/gtfs-realtime.browser.proto.js`)

  if config.showMap
    link(href=`/vendor/css/maplibre-gl.4.7.1.css` rel="stylesheet")
    script(src=`/vendor/js/maplibre-gl.4.7.1.js`)

    script(src=`/js/map-utils.js`)
    script(src=`/js/timetable-map.js`)

  if config.hasGtfsRealtimeAlerts
    script(src=`/js/anchorme.min.js`)
    
    script(src=`/js/timetable-alerts.js`)

  if config.menuType === 'radio'
    script(src=`/js/timetable-menu.js`)
    
  link(rel="stylesheet" href=`/css/timetable_styles.css`)

  link(rel="stylesheet" href=`/vendor/css/tom-select.2.6.0.css`)
