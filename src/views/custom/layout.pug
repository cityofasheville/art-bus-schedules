doctype html
html(lang="en")
  head
    -const pageTitleToUse = title ? title : pageTitle ? config.webpageTitle + ' - ' + pageTitle : config.webpageTitle;
    title= `${pageTitleToUse}`
    meta(charset="utf-8")
    meta(name="viewport" content="initial-scale=1.0, width=device-width")

    block extraHeader
      script(src=`/js/menu-behavior.js`)
      link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css")
      link(rel="stylesheet" href=`/css/global.css`)
      link(rel="stylesheet" href=`/css/tw-output.css`)

  body(class="flex flex-col min-h-screen")
    header
      a(href="#main_content" class="absolute mx-auto top-0 sr-only focus:not-sr-only") Skip to main content
      include navigation.pug


    main(id="main_content" class="flex-grow flex flex-col")
      block content 

    footer(id="main_footer")
      include feedback_widget.pug
      include footer.pug

    //- Google tag (gtag.js)
    script(async src="https://www.googletagmanager.com/gtag/js?id=G-K7V7XKDSR5")
    script.
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-K7V7XKDSR5');