doctype html
html(lang="en")
  head
    title= title
    meta(charset="utf-8")
    meta(name="viewport" content="initial-scale=1.0, width=device-width")

    block extraHeader
      //- link(rel="stylesheet" href=`https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css` integrity="sha384-1BmE4kWBq78iYhFldvKuhfTAU6auU8tT94WrHftjDbrCEXSU1oBoqyl2QvZ6jIW3" crossorigin="anonymous")
      link(rel="stylesheet" href=`/css/global.css`)
      link(rel="stylesheet" href=`/css/tw-output.css`)

  body
    header.main-header
      .header-layout
        if config.logo_url
          .logo
            a(href="/")
              img(src=`${config.logo_url}` alt=`${config.wordpress.title || 'Transit '} logo`)
        .nav-items
          a(href="https://www.ashevillenc.gov/service/transit-fares-passes/") Fares and Passes
          a(href="/map/") System Map
          a(href="/fares-and-passes/") Fares and Passes
          a(href="/plan-your-trip/") Plan Your Trip
    block content
    script.
      document.addEventListener('DOMContentLoaded', () => {
        const images = document.querySelectorAll('img[data-src]');
        images.forEach(img => {
          img.src = img.dataset.src;
          img.removeAttribute('data-src');
        });
      });
